# 本文件只提供字段示例。复制为 .env.binizox.local 后再填写本机值，禁止提交真实凭据。
COMPOSE_PROJECT_NAME=binizox
BINIZOX_POSTGRES_USER=binizox
BINIZOX_POSTGRES_PASSWORD=change-me-local-only
BINIZOX_POSTGRES_DB=binizox
BINIZOX_POSTGRES_PORT=55432
BINIZOX_REDIS_PORT=56379
BINIZOX_MINIO_PORT=59000
BINIZOX_MINIO_CONSOLE_PORT=59001
BINIZOX_MINIO_ACCESS_KEY=change-me-local-only
BINIZOX_MINIO_SECRET_KEY=change-me-local-only
BINIZOX_INSTANCE_ID=binizox-local
BINIZOX_STATE_DIR=./.runtime/binizox/full

# 本地 Python 服务使用宿主机地址；Docker Compose 会覆盖为容器服务名。
POSTGRES_URL=postgresql+asyncpg://binizox:change-me-local-only@127.0.0.1:55432/binizox
REDIS_URL=redis://127.0.0.1:56379/0
MINIO_URI=http://127.0.0.1:59000
MINIO_ACCESS_KEY=change-me-local-only
MINIO_SECRET_KEY=change-me-local-only
BINIZOX_TOOL_RUNNER_URL=http://127.0.0.1:8091
BINIZOX_PARSER_URL=http://127.0.0.1:8090
BINIZOX_MAX_DOCUMENT_BYTES=26214400
BINIZOX_USER_DATA_DIR=.runtime/binizox/user-data
BINIZOX_WORKSPACE_ROOT=.runtime/binizox/user-data
BINIZOX_TOOL_STATE_PATH=.runtime/binizox/tool-runner.sqlite3
VITE_BINIZOX_REPOSITORY_URL=https://github.com/Binizox/binizox
VITE_BINIZOX_DOCUMENTATION_URL=
VITE_BINIZOX_DEMO_URL=

# Binizox 仍需要模型和本地认证配置。由用户在忽略文件中填写，不提供真实值。
API_KEY_DERIVATION_SECRET=replace-with-independent-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-another-secret-at-least-32-characters
SANDBOX_PROVISIONER_TOKEN=replace-with-sandbox-secret-at-least-32-characters
BINIZOX_TOOL_RUNNER_TOKEN=replace-with-tool-runner-secret-at-least-32-characters
